# Backend environment variables (example)

# Server
PORT=3001
NODE_ENV=development

# CORS: allowed frontend origins
# - Single: FRONTEND_URL=http://localhost:8080
# - Multiple (comma-separated): FRONTEND_URL=http://localhost:8080,http://192.168.1.10:8080
# - Allow any origin (reflect Origin header): FRONTEND_URL=*
FRONTEND_URL=http://localhost:8080

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Fixphone
DB_USER=postgres
DB_PASSWORD=

# Optional: LINE integration (if used)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

