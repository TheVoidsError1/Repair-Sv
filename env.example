image.png# Frontend environment variables (example)
#
# Optional override for API base URL. If not set:
# - on localhost -> http://localhost:3001
# - on IP/domain  -> http(s)://<same-hostname>:3001
VITE_API_BASE_URL=

# Optional: LINE QR image shown on repair bill (ใบรับซ่อม) in the "เงื่อนไขในการซ่อม" section.
# 1) Put your QR image in the frontend public folder (e.g. `public/line-qr.png`)
# 2) Point to it with this env var:
VITE_LINE_QR_SRC=/line-qr.png
# Optional caption text under the QR (e.g. "@macfixservice" or "เพิ่มเพื่อน LINE")
VITE_LINE_QR_TEXT=LINE

